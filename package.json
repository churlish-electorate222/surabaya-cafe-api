{
  "name": "surabaya-cafe-api",
  "version": "2.0.0",
  "description": "REST API terlengkap berisi data cafe terverifikasi aktif di Surabaya — Hybrid OSM + Google Maps verification",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "scraper": "node src/bot/scraper.js",
    "verify": "node src/bot/verify_gmaps.js",
    "pipeline": "node src/bot/scraper.js && node src/bot/verify_gmaps.js",
    "validate": "node src/bot/verify_links.js",
    "import": "node src/bot/import_master_csv.js"
  },
  "keywords": [
    "surabaya",
    "cafe",
    "api",
    "google-maps",
    "coffee-shop",
    "maps-verification",
    "open-data"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "playwright": "^1.62.1"
  }
}
